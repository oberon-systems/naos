#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc reads $description itself
#
# Reports what the guest can see to ttyS1, which the runner writes to boot.log.
# The runner's boot test reads these lines; they are evidence, not enforcement.

description="Report guest isolation probes to the runner"

session_config=/sys/firmware/qemu_fw_cfg/by_name/opt/naos/session/raw
lower=/run/naos/lower

depend() {
    need localmount
    after modules naos-workspace
}

session_value() {
    sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" "$session_config" 2> /dev/null
}

report() {
    echo "$1" > /dev/ttyS1 2> /dev/null || true
}

mcp_port() {
    for name in /sys/class/virtio-ports/*/name; do
        [ "$(cat "$name" 2> /dev/null)" = naos.mcp ] || continue
        port=${name%/name}
        echo "/dev/${port##*/}"
        return 0
    done
    return 1
}

# The host must refuse writes to the share; in rw mode naos writes into the overlay, never the share.
workspace_probe() {
    grep -q " $1 " /proc/mounts || {
        echo " workspace-missing"
        return
    }
    # Guest root can remount the share rw, so the write goes through that: only virtiofsd may refuse it.
    mount -o remount,rw "$lower" 2> /dev/null
    if touch "$lower/.naos-probe" 2> /dev/null; then
        rm -f "$lower/.naos-probe"
        echo " share-writable"
    fi
    mount -o remount,ro "$lower" 2> /dev/null
    [ "$2" = rw ] || return
    if su naos -s /bin/sh -c "echo probe > '$1/.naos-probe'" 2> /dev/null; then
        [ -e "$lower/.naos-probe" ] && echo " write-reached-share"
        rm -f "$1/.naos-probe"
    else
        echo " workspace-not-writable"
    fi
}

# The runner answers on this port, so a ping proves the channel end to end.
mcp_ping() {
    exec 3<> "$1" || return 1
    printf '%s\n' '{"jsonrpc":"2.0","id":"probe","method":"ping"}' >&3
    read -r -t 10 reply <&3
    exec 3>&-
    case "$reply" in
        *'"id":"probe"'*'"result"'*) return 0 ;;
    esac
    return 1
}

start() {
    ebegin "Running naos probes"
    report naos-ready

    failures=""
    workspace=$(session_value workspace)
    mode=$(session_value workspace_mode)
    expected_disks=1
    [ "$mode" = rw ] && expected_disks=2
    disks=0
    for disk in /sys/block/vd*; do
        [ -e "$disk" ] && disks=$((disks + 1))
    done
    [ "$disks" -eq "$expected_disks" ] || failures="$failures disks=$disks"

    # The only host filesystem allowed is the workspace share, and only where it was mounted.
    grep -q ' 9p ' /proc/mounts && failures="$failures host-mounts"
    grep ' virtiofs ' /proc/mounts | grep -qv '^naos-workspace ' && failures="$failures host-mounts"
    if [ -n "$workspace" ]; then
        grep -q "^naos-workspace $lower virtiofs ro," /proc/mounts || failures="$failures host-mounts"
        failures="$failures$(workspace_probe "$workspace" "$mode")"
    elif grep -q ' virtiofs ' /proc/mounts; then
        failures="$failures host-mounts"
    fi

    for link in /sys/class/net/*; do
        name=${link##*/}
        [ "$name" = lo ] || failures="$failures interface=$name"
    done

    # Disks (2) and serial ports (3), plus the workspace share (0x1a) when the Run has one.
    for device in /sys/bus/virtio/devices/*/device; do
        [ -e "$device" ] || continue
        case "$(cat "$device")" in
            0x0002 | 0x0003) ;;
            0x001a) [ -n "$workspace" ] || failures="$failures virtio=0x001a" ;;
            *) failures="$failures virtio=$(cat "$device")" ;;
        esac
    done

    if port=$(mcp_port); then
        mcp_ping "$port" || failures="$failures mcp-ping"
    else
        failures="$failures mcp-port"
    fi

    if [ -z "$failures" ]; then
        report "naos-probe ok"
    else
        report "naos-probe fail:$failures"
    fi
    eend 0
}
