#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc reads $description itself
#
# Reports what the guest can see to ttyS1, which the runner writes to boot.log.
# The runner's boot test reads these lines; they are evidence, not enforcement.

description="Report guest isolation probes to the runner"

depend() {
    need localmount
    after modules
}

report() {
    echo "$1" > /dev/ttyS1 2> /dev/null || true
}

mcp_port() {
    for name in /sys/class/virtio-ports/*/name; do
        [ "$(cat "$name" 2> /dev/null)" = naos.mcp ] || continue
        port=${name%/name}
        echo "/dev/${port##*/}"
        return 0
    done
    return 1
}

# The runner answers on this port, so a ping proves the channel end to end.
mcp_ping() {
    exec 3<> "$1" || return 1
    printf '%s\n' '{"jsonrpc":"2.0","id":"probe","method":"ping"}' >&3
    read -r -t 10 reply <&3
    exec 3>&-
    case "$reply" in
        *'"id":"probe"'*'"result"'*) return 0 ;;
    esac
    return 1
}

start() {
    ebegin "Running naos probes"
    report naos-ready

    failures=""
    disks=0
    for disk in /sys/block/vd*; do
        [ -e "$disk" ] && disks=$((disks + 1))
    done
    [ "$disks" -eq 1 ] || failures="$failures disks=$disks"

    if grep -Eq ' (9p|virtiofs) ' /proc/mounts; then
        failures="$failures host-mounts"
    fi

    for link in /sys/class/net/*; do
        name=${link##*/}
        [ "$name" = lo ] || failures="$failures interface=$name"
    done

    # Only the disk (2) and the serial ports (3): no net, vsock, 9p or virtiofs path to the host.
    for device in /sys/bus/virtio/devices/*/device; do
        [ -e "$device" ] || continue
        case "$(cat "$device")" in
            0x0002 | 0x0003) ;;
            *) failures="$failures virtio=$(cat "$device")" ;;
        esac
    done

    if port=$(mcp_port); then
        mcp_ping "$port" || failures="$failures mcp-ping"
    else
        failures="$failures mcp-port"
    fi

    if [ -z "$failures" ]; then
        report "naos-probe ok"
    else
        report "naos-probe fail:$failures"
    fi
    eend 0
}
