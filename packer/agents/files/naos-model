#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # openrc reads these variables itself
#
# The model gateway of this Run on 127.0.0.1:4000. socat pipes each connection
# to the runner over vsock; the runner answers and holds the keys.

description="Pipe the model gateway to the runner"
session_config=/sys/firmware/qemu_fw_cfg/by_name/opt/naos/session/raw
pidfile=/run/naos-model.pid

depend() {
    need localmount
    before naos-session
}

model_port() {
    sed -n 's/.*"model_port": *\([0-9][0-9]*\).*/\1/p' "$session_config" 2> /dev/null
}

start() {
    port=$(model_port)
    if [ -z "$port" ]; then
        einfo "The Run has no model policy, so no model gateway"
        return 0
    fi
    modprobe vmw_vsock_virtio_transport 2> /dev/null || true
    ebegin "Starting the model gateway"
    start-stop-daemon --start --background --make-pidfile --pidfile "$pidfile" \
        --user naos:naos --exec /usr/bin/socat -- \
        TCP-LISTEN:4000,bind=127.0.0.1,reuseaddr,fork "VSOCK-CONNECT:2:$port"
    eend $?
}

stop() {
    [ -f "$pidfile" ] || return 0
    ebegin "Stopping the model gateway"
    start-stop-daemon --stop --pidfile "$pidfile"
    eend $?
}
