# Copy next to compose.yaml and fill it in: cp .env.example .env
# Compose itself reads these; only the NAOS_* lines further down reach a container.

# Images. A deployment pins a released tag, latest is for local testing.
NAOS_REGISTRY=ghcr.io/oberon-systems
NAOS_TAG=latest

# Where the two ports are published. 127.0.0.1 keeps them on the host the
# runner lives on; put a reverse proxy in front before binding anything wider.
NAOS_BIND=127.0.0.1
NAOS_API_PORT=8080
NAOS_WEB_PORT=8000

# Postgres. The password ends up inside the connection url, so keep it to
# url-safe characters. NAOS_DB_DATA is the host path holding the cluster, and
# it is the only state the stack keeps - back that directory up.
# Point NAOS_DB_HOST at an external server to leave the db service unused.
NAOS_DB_HOST=db
NAOS_DB_PORT=5432
NAOS_DB_NAME=naos
NAOS_DB_USER=naos
NAOS_DB_PASSWORD=
NAOS_DB_DATA=./data/db

# The api matches bearer tokens by their sha256, so only the hashes live here.
# Generate a token and its hash with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#   printf %s TOKEN | sha256sum
# The operator token is what calls /api/v1; the enrollment token is what the
# runner reads from its NAOS_AGENT_ENROLLMENT_TOKEN_FILE on the host.
NAOS_OPERATOR_TOKEN_SHA256=
NAOS_RUNNER_ENROLLMENT_TOKEN_SHA256=

# Host directories a run is allowed to mount, as a json list of absolute
# paths: ["/srv/workspaces"]. Empty means no run can mount anything.
NAOS_ALLOWED_MOUNT_ROOTS=[]

# The api endpoint the web ui shows, as an operator's browser reaches it, and
# the one the web container itself calls, which stays inside the compose network.
NAOS_WEB_API_BASE_URL=http://127.0.0.1:8080
NAOS_WEB_API_URL=http://api:8000

# The web ui reads runs and runners as an operator, so it needs the token itself
# rather than its hash. Put it in a file of its own, 0600, and name the path here;
# compose mounts it read-only and nothing else in the stack reads it.
NAOS_WEB_OPERATOR_TOKEN_FILE=
